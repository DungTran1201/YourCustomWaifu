{
  "name": "@vrm/desktop",
  "version": "0.1.0",
  "description": "YourCustomWaifu — Desktop-first personal AI companion powered by Electron",
  "main": "./dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:main": "tsc -p tsconfig.node.json && pnpm build:preload",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node ./node_modules/electron/cli.js scripts/electron-smoke.cjs",
    "package": "electron-builder --win"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@types/three": "^0.186.0",
    "@vrm/platform-contracts": "workspace:*",
    "@vrm/shared": "workspace:*",
    "three": "^0.186.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.yourcustomwaifu.desktop",
    "productName": "YourCustomWaifu",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
