{
  "name": "your-custom-waifu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-First Personal AI Companion powered by Electron",
  "scripts": {
    "dev": "pnpm dev:desktop",
    "dev:backend": "pnpm --filter @vrm/backend dev",
    "dev:desktop": "pnpm --filter @vrm/platform-contracts build && pnpm --filter @vrm/shared build && pnpm --filter @vrm/desktop dev",
    "build:desktop": "pnpm --filter @vrm/desktop build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "prettier --check \"frontend/**/*.{ts,vue,json}\" \"schemas/**/*.json\"",
    "lint:fix": "prettier --write \"frontend/**/*.{ts,vue,json}\" \"schemas/**/*.json\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
